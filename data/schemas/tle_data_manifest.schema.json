{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/tle_data_manifest.schema.json",
  "title": "Paper 1+ TLE data manifest",
  "description": "One entry per ingested satellite history. Emitted by experiments/exp14_multisat_generalization_matrix/run_multisat_generalization_matrix.py as data_manifest.json. Orbital input metadata only: reference_is_measured_truth is always false and nothing here supports packet, error-rate, receiver-acknowledgement, over-the-air, or on-orbit claims.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": [
      "satellite_name",
      "norad_id",
      "satellite_key",
      "constellation_family",
      "tle_record_count",
      "epoch_start_utc",
      "epoch_end_utc",
      "epoch_span_days",
      "median_gap_h",
      "mean_gap_h",
      "usable_staleness_bands_h",
      "reference_is_measured_truth"
    ],
    "properties": {
      "satellite_name": {
        "type": "string",
        "description": "OBJECT_NAME as ingested."
      },
      "norad_id": {
        "type": "integer",
        "minimum": 1,
        "description": "Resolved NORAD catalogue number."
      },
      "satellite_key": {
        "type": "string",
        "pattern": "^NORAD[0-9]+$",
        "description": "Stable key used in every matrix row and pair id."
      },
      "constellation_family": {
        "type": "string",
        "description": "Family/constellation if known, else 'unknown'."
      },
      "source_path": {
        "type": "string",
        "description": "Relative path of the ingested archive file."
      },
      "tle_record_count": { "type": "integer", "minimum": 2 },
      "epoch_start_utc": { "type": "string", "format": "date-time" },
      "epoch_end_utc": { "type": "string", "format": "date-time" },
      "epoch_span_days": { "type": "number", "minimum": 0 },

      "median_gap_h": { "type": ["number", "null"], "minimum": 0 },
      "mean_gap_h": { "type": ["number", "null"], "minimum": 0 },
      "p10_gap_h": { "type": ["number", "null"], "minimum": 0 },
      "p90_gap_h": { "type": ["number", "null"], "minimum": 0 },
      "max_gap_h": { "type": ["number", "null"], "minimum": 0 },

      "mean_altitude_km": { "type": "number" },
      "min_altitude_km": { "type": "number" },
      "max_altitude_km": { "type": "number" },
      "mean_inclination_deg": { "type": "number", "minimum": 0, "maximum": 180 },
      "min_inclination_deg": { "type": "number", "minimum": 0, "maximum": 180 },
      "max_inclination_deg": { "type": "number", "minimum": 0, "maximum": 180 },
      "mean_eccentricity": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
      "min_eccentricity": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
      "max_eccentricity": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
      "mean_bstar": { "type": "number" },
      "min_bstar": { "type": "number" },
      "max_bstar": { "type": "number" },

      "usable_staleness_bands_h": {
        "type": "array",
        "items": { "type": "integer", "enum": [8, 24, 48, 72, 96, 168] },
        "uniqueItems": true,
        "description": "Bands with enough candidate pairs to fill train/validation/test. A band absent here cannot appear as an evaluated matrix row."
      },
      "reference_is_measured_truth": {
        "type": "boolean",
        "const": false,
        "description": "Always false. The reference Doppler is a later TLE propagated by SGP4, never an RF measurement."
      }
    }
  }
}
